# Database
DATABASE_URL="postgresql://user:password@localhost:5432/clinic_db?schema=public"

# Auth
JWT_SECRET="replace-with-a-long-random-string"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-string"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# App
PORT=4000
NODE_ENV=development
CLIENT_URL="http://localhost:5173"

# WhatsApp BSP (fill in once provider is chosen — e.g. AiSensy/Interakt)
WHATSAPP_PROVIDER="aisensy"
WHATSAPP_API_KEY=""
WHATSAPP_API_BASE_URL=""

# Super admin seed (used only by `npm run seed:super-admin`)
SUPER_ADMIN_NAME="Platform Admin"
SUPER_ADMIN_PHONE="9000000000"
SUPER_ADMIN_EMAIL="superadmin@platform.test"
SUPER_ADMIN_PASSWORD="changeme123"

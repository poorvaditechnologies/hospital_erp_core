generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  FRONT_DESK
  DOCTOR
}

enum ClinicCategory {
  AYURVEDIC
  DENTAL
}

enum SubscriptionPlan {
  TRIAL
  STANDARD
  PREMIUM
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  CANCELLED
}

enum VisitType {
  SWARNA_PRASHANA
  WALKIN
  CHECKUP
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum NotesVisibility {
  DOCTOR_ONLY
  ALL_STAFF
}

enum KitOrderPaymentStatus {
  PENDING
  PAID
  FAILED
}

enum KitOrderStatus {
  PLACED
  SHIPPED
  DELIVERED
  CANCELLED
}

enum TemplateCategory {
  UTILITY
  MARKETING
  AUTHENTICATION
}

enum TemplateApprovalStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
}

enum MessageStatus {
  SENT
  DELIVERED
  FAILED
}

model Clinic {
  id                 String         @id @default(cuid())
  name               String
  category           ClinicCategory @default(AYURVEDIC)
  phone              String
  address             String?
  isActive            Boolean  @default(true)
  whatsappBspConfig   String? // encrypted JSON blob
  createdAt           DateTime @default(now())

  subscription Subscription?
  users        User[]
  patients     Patient[]
  visits       Visit[]
  kitOrders    KitOrder[]
  templates    WhatsAppTemplate[]
  messageLogs  WhatsAppMessageLog[]
}

model Subscription {
  id          String             @id @default(cuid())
  clinicId    String             @unique
  plan        SubscriptionPlan   @default(TRIAL)
  status      SubscriptionStatus @default(TRIAL)
  startedAt   DateTime           @default(now())
  renewsAt    DateTime?
  cancelledAt DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  clinic Clinic @relation(fields: [clinicId], references: [id])
}

model User {
  id           String   @id @default(cuid())
  clinicId     String
  name         String
  phone        String
  email        String?
  passwordHash String
  role         UserRole @default(FRONT_DESK)
  isSuperAdmin Boolean  @default(false)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  clinic              Clinic               @relation(fields: [clinicId], references: [id])
  visits              Visit[]              @relation("VisitDoctor")
  messageLogs         WhatsAppMessageLog[]
  passwordResetTokens PasswordResetToken[]

  @@unique([clinicId, phone])
  @@index([clinicId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

model Patient {
  id            String    @id @default(cuid())
  clinicId      String
  name          String
  phone         String
  dob           DateTime?
  gender        Gender?
  email         String?
  bloodGroup    String?
  guardianName  String?
  address       String?
  createdAt     DateTime  @default(now())

  clinic        Clinic    @relation(fields: [clinicId], references: [id])
  visits        Visit[]
  kitOrders     KitOrder[]
  messageLogs   WhatsAppMessageLog[]

  @@unique([clinicId, phone])
  @@index([clinicId])
  @@index([phone])
}

model Visit {
  id               String           @id @default(cuid())
  clinicId         String
  patientId        String
  doctorId         String?
  visitType        VisitType
  visitDate        DateTime         @default(now())
  complaint        String?
  diagnosis        String?
  prescriptionNotes String?
  nextFollowUpDate DateTime?
  notesVisibility  NotesVisibility  @default(ALL_STAFF)
  createdAt        DateTime         @default(now())

  clinic    Clinic  @relation(fields: [clinicId], references: [id])
  patient   Patient @relation(fields: [patientId], references: [id])
  doctor    User?   @relation("VisitDoctor", fields: [doctorId], references: [id])

  @@index([clinicId])
  @@index([patientId])
  @@index([visitDate])
}

model KitOrder {
  id              String                 @id @default(cuid())
  clinicId        String
  patientId       String?
  items           String
  quantity        Int                    @default(1)
  amount          Int
  paymentStatus   KitOrderPaymentStatus  @default(PENDING)
  status          KitOrderStatus         @default(PLACED)
  shippingAddress String
  orderDate       DateTime               @default(now())
  shippedDate     DateTime?

  clinic  Clinic   @relation(fields: [clinicId], references: [id])
  patient Patient? @relation(fields: [patientId], references: [id])

  @@index([clinicId])
}

model WhatsAppTemplate {
  id              String                  @id @default(cuid())
  clinicId        String
  name            String
  category        TemplateCategory
  bodyText        String
  variables       String? // JSON array of variable names
  approvalStatus  TemplateApprovalStatus  @default(DRAFT)
  metaTemplateId  String?
  createdAt       DateTime                @default(now())

  clinic       Clinic               @relation(fields: [clinicId], references: [id])
  messageLogs  WhatsAppMessageLog[]

  @@index([clinicId])
}

model WhatsAppMessageLog {
  id          String        @id @default(cuid())
  clinicId    String
  patientId   String
  templateId  String
  triggeredBy String
  status      MessageStatus @default(SENT)
  sentAt      DateTime      @default(now())

  clinic   Clinic           @relation(fields: [clinicId], references: [id])
  patient  Patient          @relation(fields: [patientId], references: [id])
  template WhatsAppTemplate @relation(fields: [templateId], references: [id])
  user     User             @relation(fields: [triggeredBy], references: [id])

  @@index([clinicId])
}
